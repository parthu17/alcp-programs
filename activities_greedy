#include<bits/stdc++.h>
using namespace std;
int main(){
	int n;
	cout<<"enter number of actvities\n";
	cin>>n;
	vector<pair<int,int>> activities(n);
	for(int i=0;i<n;i++){
		cin>>activities[i].first>>activities[i].second;
	}
	sort(activities.begin(),activities.end(),[] (const pair<int,int> &a,const pair<int,int>&b){
		return a.second<b.second;
	});
	vector<pair<int,int>> selected;
	selected.push_back(activities[0]);
	int last_finish=activities[0].second;
	for(int i=1;i<n;i++){
		if(activities[i].first>=last_finish){
			selected.push_back(activities[i]);
			last_finish=activities[i].second;
		}
	}
	for(auto &t:selected){
		cout<<t.first<<" "<<t.second<<"\n";
	}
	return 0;
}
