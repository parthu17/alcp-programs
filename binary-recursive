#include<iostream>
using namespace std;
int binarysearch(int a[],int low,int high,int target){
	if(low>high){
		return -1;
	}
	else{
		int mid=(low+high)/2;
		if(a[mid]==target){
			return mid;
		}
		else if(a[mid]>target){
			binarysearch(a,low,mid-1,target);
		}
		else{
			binarysearch(a,mid+1,high,target);
		}
	}
}
int main(){
	cout<<"enter number of elements";
	int n;
	cin>>n;
	int* arr=new int[n];
	for(int i=0;i<n;i++){
		cout<<"enter element\n";
		cin>>arr[i];
	}
	cout<<"enter target";
	int target;
	cin>>target;
	cout<<binarysearch(arr,0,n-1,target);
	return 0;
}
	
