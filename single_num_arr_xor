#include<vector>
#include<iostream>
using namespace std;
int singlenum(vector<int> &nums){
	int result=0;
	for(int i=0;i<nums.size();i++){
		result^=nums[i];
	}
	return result;
	
}
int main(){
    int arr_size;
    cout<<"enter the size of array\n";
    cin>>arr_size;
    vector<int> nums(arr_size);
    for(int i=0;i<arr_size;i++){
        cout<<"enter element "<<i+1<<endl;
        cin>>nums[i];

    }
    cout<<"result is "<<singlenum(nums)<<endl;
    return 0;
}
