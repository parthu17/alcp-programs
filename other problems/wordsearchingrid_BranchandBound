#include <bits/stdc++.h>
using namespace std;
// One node of the state space tree: a path of cells whose letters match
// the first k letters of the word.
struct State {
int r, c; vector<int> path; // last cell of the path
// ids (r * cols + c) of all cells on the path
};
// Bounding check done BEFORE any search: the board must contain every
// letter at least as many times as the word needs it.
bool enoughLetters(vector<vector<char>> &board, int rows, int cols,
string &word) {
map<char, int> have, need;
for (int r = 0; r < rows; r++)
for (int c = 0; c < cols; c++)
have[board[r][c]]++;
for (char ch : word) need[ch]++;
for (auto &p : need) {
if (have[p.first] < p.second) return false;
}
return true;
}
bool wordSearchBnB(vector<vector<char>> &board, int rows, int cols,
string &word, int &nodesCreated) {
nodesCreated = 0;
if (!enoughLetters(board, rows, cols, word)) return false; // bound
queue<State> live;
// Level 1: every cell holding the first letter is a live node
for (int r = 0; r < rows; r++) {
for (int c = 0; c < cols; c++) {
if (board[r][c] == word[0]) {
State s;
s.r = r;
s.c = c;
s.path.push_back(r * cols + c);
live.push(s);
nodesCreated++;
}
}
}
int dr[4] = {1, -1, 0, 0};
int dc[4] = {0, 0, 1, -1};
while (!live.empty()) {
State s = live.front(); live.pop();
// FIFO: oldest live node first
int matched = s.path.size(); if (matched == (int)word.size()) return true;
// letters matched so far
for (int k = 0; k < 4; k++) { int nr = s.r + dr[k];
int nc = s.c + dc[k];
// branch: 4 directions
if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) continue;
if (board[nr][nc] != word[matched]) continue; // wrong letter
int id = nr * cols + nc;
if (find(s.path.begin(), s.path.end(), id) != s.path.end())
continue; // cell reused
State child = s; child.r = nr;
child.c = nc;
child.path.push_back(id);
live.push(child);
nodesCreated++;
// every node keeps its own path
}
}
return false;
}
int main() {
int rows, cols;
cout << "Enter number of rows and columns: ";
cin >> rows >> cols;
vector<vector<char>> board(rows, vector<char>(cols));
cout << "Enter the board row by row (no spaces):\n";
for (int r = 0; r < rows; r++) {
string rowStr;
cin >> rowStr;
for (int c = 0; c < cols; c++) board[r][c] = rowStr[c];
}
string word;
cout << "Enter the word to search: ";
cin >> word;
int nodesCreated = 0;
bool found = wordSearchBnB(board, rows, cols, word, nodesCreated);
cout << (found ? "Word exists on the board." :
"Word does not exist on the board.") << endl;
cout << "State space nodes created: " << nodesCreated << endl;
return 0;
}
