#include <bits/stdc++.h>
using namespace std;
struct Item {
int weight;
int value;
};
// One node of the state space tree
struct Node {
int level; int profit; int weight; double bound; // index of the last item decided (-1 for the root)
// total value of the items taken so far
// total weight of the items taken so far
// upper bound on the best profit reachable from here
};
// Priority queue order: the node with the LARGEST bound comes out first
struct Compare {
bool operator()(const Node &a, const Node &b) {
return a.bound < b.bound;
}
};
// Items with a higher value/weight ratio come first
bool byRatio(const Item &a, const Item &b) {
return (double)a.value / a.weight > (double)b.value / b.weight;
}
// Bounding function: fill the remaining capacity with the remaining items
// in ratio order, allowing a FRACTION of the last item. This optimistic
// estimate can never be lower than the true 0/1 answer for this subtree.
double bound(const Node &u, int n, int W, vector<Item> &items) {
double result = u.profit;
int totalWeight = u.weight;
int j = u.level + 1;
while (j < n && totalWeight + items[j].weight <= W) {
totalWeight += items[j].weight;
result += items[j].value;
j++;
}
if (j < n) {
result += (W - totalWeight) * (double)items[j].value / items[j].weight;
}
return result;
}
int knapsackBnB(vector<Item> &items, int n, int W) {
sort(items.begin(), items.end(), byRatio);
priority_queue<Node, vector<Node>, Compare> pq;
Node root = {-1, 0, 0, 0};
root.bound = bound(root, n, W, items);
pq.push(root);
int maxProfit = 0; // best complete answer so far
while (!pq.empty()) {
Node u = pq.top();
pq.pop();
if (u.bound <= maxProfit) continue; // prune: cannot beat the best
if (u.level == n - 1) continue; // no items left to decide
int next = u.level + 1;
// Child 1: TAKE the next item
Node take = {next, u.profit + items[next].value,
u.weight + items[next].weight, 0};
if (take.weight <= W) { // prune: overweight
if (take.profit > maxProfit) maxProfit = take.profit;
take.bound = bound(take, n, W, items);
if (take.bound > maxProfit) pq.push(take);
}
// Child 2: SKIP the next item
Node skip = {next, u.profit, u.weight, 0};
skip.bound = bound(skip, n, W, items);
if (skip.bound > maxProfit) pq.push(skip);
}
return maxProfit;
}
int main() {
int n;
cout << "Enter number of items: ";
cin >> n;
vector<Item> items(n);
cout << "Enter " << n << " weights: ";
for (int i = 0; i < n; i++) cin >> items[i].weight;
cout << "Enter " << n << " values: ";
for (int i = 0; i < n; i++) cin >> items[i].value;
int W;
cout << "Enter knapsack capacity: ";
cin >> W;
cout << "Maximum value: " << knapsackBnB(items, n, W) << endl;
return 0;
}
