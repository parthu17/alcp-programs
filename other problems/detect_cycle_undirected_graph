bool isCyclicUtil(int v, vector<vector<int>>& adj, vector<bool>& visited, int parent) {
    visited[v] = true;
    for (int u : adj[v]) {
        if (!visited[u]) {
            if (isCyclicUtil(u, adj, visited, v)) return true;
        } else if (u != parent) return true;
    }
    return false;
}
bool isCyclic(int V, vector<vector<int>>& adj) {
    vector<bool> visited(V, false);
    for (int i = 0; i < V; i++)
        if (!visited[i] && isCyclicUtil(i, adj, visited, -1))
            return true;
    return false;
}
