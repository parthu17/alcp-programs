#include<iostream>
#include<vector>
using namespace std;
void sum_avg(int a[],int n){
	int sum=0;
	for(int i=0;i<n;i++){
		sum+=a[i];
	}
	cout<<"sum is "<<sum<<endl;
	float avg=(float)sum/n;
	cout<<"average is "<<avg<<endl;
}
int main(){
	int a[]={1,2,3,4,5,67,89};
	int n=sizeof(a)/sizeof(a[0]);
	
	sum_avg(a,n);
	return 0;
}
