#include<iostream>
#include<vector>
using namespace std;
void sum_avg(int a[],int n){
	int sum=0;
	for(int i=0;i<n;i++){
		sum+=a[i];
	}
	cout<<"sum is "<<sum<<endl;
	float avg=(float)sum/n;
	cout<<"average is "<<avg<<endl;
}
int main(){
	cout<<"enter number of elements\n";
	int n;
	cin>>n;
	int* arr=new int[n];
	for(int i=0;i<n;i++){
		cout<<"enter element\n";
		cin>>arr[i];
	}
	
	
	sum_avg(arr,n);
	return 0;
}
