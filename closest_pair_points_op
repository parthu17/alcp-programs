#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <cfloat>

using namespace std;

// Structure to represent a 2D Point
struct Point {
    double x, y;
};

// Helper function to compare points based on X-coordinates
bool compareX(const Point& a, const Point& b) {
    return a.x < b.x;
}

// Helper function to compare points based on Y-coordinates
bool compareY(const Point& a, const Point& b) {
    return a.y < b.y;
}

// Helper function to calculate Euclidean distance between two points
double distance(Point p1, Point p2) {
    return sqrt((p1.x - p2.x) * (p1.x - p2.x) + (p1.y - p2.y) * (p1.y - p2.y));
}
double stripClosest(vector<Point>& strip, double d) {
    double minDist = d;

    // Sort the strip points by their Y-coordinate
    sort(strip.begin(), strip.end(), compareY);

    // Geometrically, the inner loop runs at most 7 times for each point
    for (size_t i = 0; i < strip.size(); ++i) {
        for (size_t j = i + 1; j < strip.size() && (strip[j].y - strip[i].y) < minDist; ++j) {
            double dist = distance(strip[i], strip[j]);
            if (dist < minDist) {
                minDist = dist;
            }
        }
    }
    return minDist;
}

// Recursive function executing the Divide and Conquer logic
double closestPairRecursive(vector<Point>& Px, int start, int end) {
    int n = end - start;

    // Base Case: Use brute force if there are 3 or fewer points
    if (n <= 3) {
        return bruteForce(Px, start, end);
    }

    // Find the midpoint index
    int mid = start + n / 2;
    Point midPoint = Px[mid];

    // Recurrence step: 2 * T(n/2)
    double dl = closestPairRecursive(Px, start, mid);
    double dr = closestPairRecursive(Px, mid, end);

    // Find the minimum of both halves
    double d = min(dl, dr);

    // Create the strip containing points closer than distance 'd' to the dividing line
    vector<Point> strip;
    for (int i = start; i < end; i++) {
        if (abs(Px[i].x - midPoint.x) < d) {
            strip.push_back(Px[i]);
        }
    }

    // Combine step: Check if the strip yields a smaller distance
    return min(d, stripClosest(strip, d));
}

// Driver function to set up the Optimal Algorithm
double getClosestPairOptimal(vector<Point> P) {
    // One-time pre-sorting cost: O(n log n)
    sort(P.begin(), P.end(), compareX);

    // Start the recursive processing
    return closestPairRecursive(P, 0, P.size());
}

// ==========================================
// MAIN FUNCTION
// ==========================================
int main() {
    vector<Point> points = { {2, 3}, {12, 30}, {40, 50}, {5, 1}, {12, 10}, {3, 4} };

    cout << "--- Closest Pair of Points ---" << endl;
    
    cout << "Optimal Algo Distance: " << getClosestPairOptimal(points) << endl;

    return 0;
}

