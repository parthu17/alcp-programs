#include<bits/stdc++.h>
using namespace std;
void reverse(vector<int> &arr,int start,int end){
	while(start<end){
		swap(arr[start],arr[end]);
		start++;
		end--;
	}
}
vector<int> rotatearr(vector<int> &nums,int k){
	vector<int> result(nums.size());
	k=k%(nums.size());
	reverse(nums,0,nums.size()-1);
	reverse(nums,0,k-1);
	reverse(nums,k,nums.size()-1);
	for(int i=0;i<nums.size();i++){
		result[i]=nums[i];
	}
	return result;
}
int main(){
	int ar_size;
	cout<<"enter array size\n";
	cin>>ar_size;
	vector<int> nums(ar_size);
	for(int i=0;i<ar_size;i++){
		cout<<"enter element "<<i+1<<endl;
		cin>>nums[i];
	}
	int k;
	cout<<"enter number of rotations"<<endl;
	cin>>k;
	cout<<"result is "<<endl;
	vector<int> result=rotatearr(nums,k);
	for(int x:result){
	    cout<<x<<" ";
	}
	return 0;
}
