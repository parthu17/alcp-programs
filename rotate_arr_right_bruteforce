#include<bits/stdc++.h>
using namespace std;
vector<int> rotatearr(vector<int> nums,int k){
	vector<int>rotatele(k);
	for(int i=0;i<k;i++){
		rotatele[i]=nums[nums.size()-k+i];
	}
	for(int i=nums.size()-1;i>=0;i--){
		nums[i+k]=nums[i];
	}
	for(int i=0;i<k;i++){
		nums[i]=rotatele[i];
	}
	return nums;
}
int main(){
	int ar_size;
	cout<<"enter array size\n";
	cin>>ar_size;
	vector<int> nums(ar_size);
	for(int i=0;i<ar_size;i++){
		cout<<"enter element "<<i+1<<endl;
		cin>>nums[i];
	}
	int k;
	cout<<"enter number of rotations"<<endl;
	cin>>k;
	cout<<"result is "<<endl;
	vector<int>result=rotatearr(nums,k);
	for(int i:result){
		cout<<i<<" ";
	}
	return 0;
}
